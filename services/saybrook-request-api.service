[Unit]
Description=Saybrook request intake SQLite writer API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/tt/.openclaw/workspace/projects/new-ashtabula-initiative
ExecStart=/usr/bin/env python3 /home/tt/.openclaw/workspace/projects/new-ashtabula-initiative/nai saybrook-request-api --host 0.0.0.0 --port 18765
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
