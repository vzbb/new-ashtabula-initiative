import React, { useState } from 'react';
import InstantDirtQuote from './components/InstantDirtQuote';
import SnapToQuoteFence from './components/SnapToQuoteFence';
import EarthFlowEstimator from './components/EarthFlowEstimator';
import { Settings2 } from 'lucide-react';

export default function App() {
  const [activeTool, setActiveTool] = useState<'dirt' | 'fence' | 'earth'>('dirt');

  return (
    <div className="min-h-screen bg-slate-50 flex flex-col font-sans">
      {/* Subtle Header / Selector */}
      <header className="bg-white border-b border-slate-200 px-6 py-3 flex items-center justify-between sticky top-0 z-[1000]">
        <div className="flex items-center gap-2">
          {activeTool === 'dirt' && <div className="font-bold text-emerald-700 tracking-tight text-lg">Instant-Dirt</div>}
          {activeTool === 'fence' && <div className="font-bold text-indigo-700 tracking-tight text-lg">Snap-to-Quote</div>}
          {activeTool === 'earth' && <div className="font-bold text-amber-700 tracking-tight text-lg">EarthFlow</div>}
        </div>
        
        {/* Very subtle selector for internal use / demo purposes */}
        <div className="group relative">
          <button className="p-2 text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-100 transition-colors">
            <Settings2 className="w-4 h-4" />
          </button>
          <div className="absolute right-0 top-full mt-2 w-48 bg-white rounded-xl shadow-xl border border-slate-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all transform origin-top-right scale-95 group-hover:scale-100 z-[1001]">
            <div className="p-1">
              <button 
                onClick={() => setActiveTool('dirt')}
                className={`w-full text-left px-4 py-2 text-sm rounded-lg transition-colors ${activeTool === 'dirt' ? 'bg-emerald-50 text-emerald-700 font-medium' : 'text-slate-600 hover:bg-slate-50'}`}
              >
                Instant-Dirt Quote
              </button>
              <button 
                onClick={() => setActiveTool('fence')}
                className={`w-full text-left px-4 py-2 text-sm rounded-lg transition-colors ${activeTool === 'fence' ? 'bg-indigo-50 text-indigo-700 font-medium' : 'text-slate-600 hover:bg-slate-50'}`}
              >
                Snap-to-Quote Fence
              </button>
              <button 
                onClick={() => setActiveTool('earth')}
                className={`w-full text-left px-4 py-2 text-sm rounded-lg transition-colors ${activeTool === 'earth' ? 'bg-amber-50 text-amber-700 font-medium' : 'text-slate-600 hover:bg-slate-50'}`}
              >
                EarthFlow Estimator
              </button>
            </div>
          </div>
        </div>
      </header>

      <main className="flex-1 p-4 lg:p-6 overflow-hidden">
        <div className="max-w-7xl mx-auto h-full min-h-[calc(100vh-8rem)]">
          {activeTool === 'dirt' && <InstantDirtQuote />}
          {activeTool === 'fence' && <SnapToQuoteFence />}
          {activeTool === 'earth' && <EarthFlowEstimator />}
        </div>
      </main>
    </div>
  );
}
