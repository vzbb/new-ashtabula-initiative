def cmd_fix_bases(_: argparse.Namespace) -> int:
    """Fix vite.config.js base paths for route-prefixed deploys."""
    import re
    
    slugs = load_public_slugs()
    fixed = []
    errors = []
    
    for slug in slugs:
        site_dir = site_dir_for_slug(slug)
        if not site_dir.exists():
            continue
            
        base_ok, current_base, expected_base = check_vite_base_matches_route(slug, site_dir)
        if base_ok:
            continue
        desired_base = "./"
            
        # Find and fix vite.config.js/ts
        for config_name in ["vite.config.js", "vite.config.ts"]:
            config_path = site_dir / config_name
            if not config_path.exists():
                continue
                
            text = config_path.read_text()
            
            # Pattern to match base property
            pattern = r"(base\s*:\s*)['\"]([^'\"]+)['\"]"
            
            if re.search(pattern, text):
                new_text = re.sub(pattern, rf"\1'{desired_base}'", text)
                config_path.write_text(new_text)
                fixed.append({
                    "slug": slug,
                    "folder": site_dir.name,
                    "old": current_base,
                    "new": desired_base,
                    "config": config_name
                })
                print(f"✅ Fixed {slug}: {current_base} → {desired_base}")
                break
        else:
            errors.append(slug)
    
    if fixed:
        print(f"\n✅ Fixed {len(fixed)} vite.config.js base path(s)")
        print("\nNext steps:")
        print("  1. Run './nai build' to rebuild all sites")
        print("  2. Run './nai deploy' to deploy to production")
    
    if errors:
        print(f"\n❌ Could not fix {len(errors)} site(s): {', '.join(errors)}")
        return 1
    
    if not fixed:
        print("✅ All vite.config.js base paths are already correct!")
    
    return 0


def cmd_deploy(args: argparse.Namespace) -> int:
    if not args.confirm_production and os.environ.get("NAI_CONFIRM_PRODUCTION_DEPLOY") != "1":
        print("Production deploy blocked by default.")
        print("")
        print("This command builds every site, prepares a pruned Vercel Build Output")
        print("directory, and deploys the prebuilt output to production.")
        print("")
        print("Run one of these only when you intend to publish production:")
        print("  ./nai deploy --confirm-production")
        print("  NAI_CONFIRM_PRODUCTION_DEPLOY=1 ./nai deploy")
        return 2

    if cmd_build(argparse.Namespace()) != 0:
        return 1

    print("")
    print("Preparing pruned Vercel output...")
    prepare_vercel_output()

    print("")
    print("Deploying prebuilt output to production...")
    subprocess.run([*vercel_cmd(), "deploy", "--prebuilt", "--archive=tgz", "--prod", "--yes"], cwd=ROOT, check=True)
    return 0


