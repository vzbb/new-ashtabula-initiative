def tool_python() -> str:
    override = os.environ.get("NAI_PYTHON")
    if override:
        return override
    if NAI_TOOLS_VENV.exists():
        return str(NAI_TOOLS_VENV)
    return sys.executable


def vercel_cmd() -> list[str]:
    vercel_bin = shutil.which("vercel")
    if vercel_bin:
        return [vercel_bin]
    return ["npx", "--yes", "vercel"]


def _slugify(value: str) -> str:
    import re

    slug = value.strip().lower()
    slug = re.sub(r"[^a-z0-9]+", "-", slug)
    slug = re.sub(r"-{2,}", "-", slug).strip("-")
    return slug


def _clean_category_label(value: str) -> str:
    import re

    return re.sub(r"\s*\(\d+\s+sites?\)\s*$", "", value.strip())


def _collect_clone_rewrite_targets(parent_dir: Path, parent_slug: str, parent_folder: str, parent_target: str) -> list[str]:
    candidates: list[str] = []
    needles = tuple(filter(None, [parent_slug, f"/{parent_slug}/", parent_folder, parent_target]))
    for path in sorted(parent_dir.rglob("*")):
        if not path.is_file():
            continue
        if any(part in {"node_modules", "dist", ".vercel"} for part in path.parts):
            continue
        if path.suffix.lower() not in {
            ".js", ".jsx", ".ts", ".tsx", ".json", ".html", ".md", ".css", ".txt", ".svg", ".yml", ".yaml"
        }:
            continue
        try:
            text = path.read_text(errors="ignore")
        except OSError:
            continue
        if any(needle and needle in text for needle in needles):
            candidates.append(path.relative_to(parent_dir).as_posix())
    return candidates


def _copy_clone_tree(parent_dir: Path, child_dir: Path) -> None:
    def _ignore(path: str, names: list[str]) -> set[str]:
        ignored = {"node_modules", "dist", ".vercel", "__pycache__"}
        return {name for name in names if name in ignored}

    shutil.copytree(parent_dir, child_dir, ignore=_ignore)


def _rewrite_clone_files(
    child_dir: Path,
    rewrite_targets: list[str],
    parent_slug: str,
    new_slug: str,
    parent_folder: str,
    new_folder: str,
    parent_site_name: str,
    site_name: str,
    parent_target: str,
    target: str,
) -> None:
    route_placeholder = "__NAI_ROUTE_PLACEHOLDER__"
    slug_placeholder = "__NAI_SLUG_PLACEHOLDER__"
    replacements = [
        (f"/{parent_slug}/", route_placeholder),
        (parent_slug, slug_placeholder),
        (parent_folder, new_folder),
        (parent_site_name, site_name),
        (parent_target, target),
    ]
    for rel_path in rewrite_targets:
        path = child_dir / rel_path
        if not path.exists() or not path.is_file():
            continue
        text = path.read_text(errors="ignore")
        original = text
        for old, new in replacements:
            if old and new:
                text = text.replace(old, new)
        text = text.replace(route_placeholder, f"/{new_slug}/")
        text = text.replace(slug_placeholder, new_slug)
        if text != original:
            path.write_text(text)


def cmd_clone_mvp(args: argparse.Namespace) -> int:
    data = load_sitemap_data()
    errors = validate_sitemap_data(data)
    if errors:
        for error in errors:
            print(f"❌ {error}")
        return 1

    parent_slug = args.parent_slug.strip()
    new_slug = _slugify(args.new_slug)
    site_name = args.site_name.strip()
    target = args.target.strip()
    description = args.description.strip()

    parent_route = find_route_by_slug(parent_slug)
    if parent_route is None:
        print(f"❌ Parent slug `{parent_slug}` does not exist in SITEMAP.json")
        return 1

    existing = find_route_by_slug(new_slug)
    if existing is not None:
        print(f"❌ New slug `{new_slug}` already exists in the canonical sitemap")
        return 1

    parent_dir = site_dir_for_slug(parent_slug)
    if not parent_dir.exists():
        print(f"❌ Parent site folder is missing: {parent_dir.relative_to(ROOT)}")
        return 1

    parent_build = find_best_build_root(parent_dir)
    if parent_build is None and not args.force:
        print(f"❌ Parent `{parent_slug}` does not currently resolve to a build root. Use --force to inspect anyway.")
        return 1

    new_folder = _slugify(args.new_folder or new_slug)
    child_dir = ROOT / "websites" / new_folder
    if child_dir.exists():
        print(f"❌ Target folder already exists: {child_dir.relative_to(ROOT)}")
        return 1

    category = _clean_category_label(args.category) if args.category else _clean_category_label(str(parent_route.get("category", "")))
    if not category:
        print("❌ Category is required because the parent route does not provide one")
        return 1

    parent_target = str(parent_route.get("target", "")).strip()
    route_index = args.index if args.index is not None else next_route_index()
    route_url = f"https://new-ashtabula-initiative.com/{new_slug}/"
    route_path = f"/{new_slug}/"

    route_record = {
        "index": route_index,
        "site": site_name,
        "slug": new_slug,
        "url": route_url,
        "target": target,
        "description": description,
        "category": category,
    }

    notes = args.notes.strip() if args.notes else ""
    ledger_record = {
        "site": site_name,
        "route": route_path,
        "primary_target": target,
        "secondary_targets": args.secondary_targets.strip() if args.secondary_targets else "",
        "notes": notes or (
            f"Child clone of {parent_route.get('site', parent_slug)} for {target}; parent route {parent_slug} remains canonical."
        ),
    }

    files_to_copy = []
    for path in sorted(parent_dir.rglob("*")):
        if any(part in {"node_modules", "dist", ".vercel"} for part in path.parts):
            continue
        files_to_copy.append(path.relative_to(parent_dir).as_posix() + ("/" if path.is_dir() else ""))
    files_to_copy = [p for p in files_to_copy if p != "./"]

    rewrite_targets = _collect_clone_rewrite_targets(parent_dir, parent_slug, parent_dir.name, parent_target)
    artifacts_to_create = [
        f"lead_research_json/{new_slug}.json",
        f"brandkits/{new_slug}.json",
        f"branding_research/{new_slug}/branding.md",
    ]

    print("=== NAI clone-mvp dry run ===")
    print("")
    print("Parent")
    print(f"- slug: {parent_slug}")
    print(f"- site: {parent_route.get('site', '')}")
    print(f"- target: {parent_target}")
    print(f"- folder: {parent_dir.relative_to(ROOT)}")
    print(f"- build root: {parent_build.relative_to(parent_dir).as_posix() if parent_build else 'missing'}")
    print("")
    print("Child")
    print(f"- slug: {new_slug}")
    print(f"- site name: {site_name}")
    print(f"- target: {target}")
    print(f"- folder: {child_dir.relative_to(ROOT)}")
    print(f"- route: {route_path}")
    print(f"- category: {category}")
    print("")
    print("Proposed route record")
    print(json.dumps(route_record, indent=2))
    print("")
    print("Proposed target-ledger row")
    print(json.dumps(ledger_record, indent=2))
    print("")
    print("Planned artifact stubs")
    for path in artifacts_to_create:
        print(f"- {path}")
    print("")
    print("Likely structural rewrite targets")
    if rewrite_targets:
        for path in rewrite_targets[:50]:
            print(f"- {path}")
        if len(rewrite_targets) > 50:
            print(f"- ... and {len(rewrite_targets) - 50} more")
    else:
        print("- none detected")
    print("")
    print("Follow-up commands")
    print("- ./nai sitemap-validate")
    print("- ./nai sitemap-render-md")
    print("- ./nai routes")
    print(f"- cd {child_dir.relative_to(ROOT)} && npm run build")
    print("- ./nai scan")
    print("")
    if args.dry_run:
        print("Dry run only. No files were written.")
        return 0

    sitemap_path = ROOT / "SITEMAP.json"
    original_sitemap = sitemap_path.read_text()
    created_child_dir = False

    try:
        _copy_clone_tree(parent_dir, child_dir)
        created_child_dir = True

        _rewrite_clone_files(
            child_dir=child_dir,
            rewrite_targets=rewrite_targets,
            parent_slug=parent_slug,
            new_slug=new_slug,
            parent_folder=parent_dir.name,
            new_folder=new_folder,
            parent_site_name=str(parent_route.get("site", "")).strip(),
            site_name=site_name,
            parent_target=parent_target,
            target=target,
        )

        mutable = dict(data)
        routes = [route for route in mutable.get("routes", []) if isinstance(route, dict)]
        routes.append(route_record)
        routes.sort(key=lambda route: (int(route.get("index", 0) or 0), str(route.get("slug", ""))))
        mutable["routes"] = routes

        ledger = [entry for entry in mutable.get("target_ledger", []) if isinstance(entry, dict)]
        ledger.append(ledger_record)
        mutable["target_ledger"] = ledger

        write_sitemap_json(mutable, sitemap_path)
        render_markdown_from_json()

        print(f"✅ Cloned parent into {child_dir.relative_to(ROOT)}")
        print(f"✅ Added canonical route `{new_slug}` to SITEMAP.json")
        print("✅ Rendered SITEMAP.md from canonical data")
        print("")
        print("Next steps:")
        print("- ./nai sitemap-validate")
        print("- ./nai routes")
        print(f"- cd {child_dir.relative_to(ROOT)} && npm run build")
        print("- ./nai scan")
        return 0
    except Exception as exc:
        sitemap_path.write_text(original_sitemap)
        if created_child_dir and child_dir.exists():
            shutil.rmtree(child_dir)
        print(f"❌ Clone failed and was rolled back: {exc}")
        return 1

def cmd_scan(_: argparse.Namespace) -> int:
    slugs = load_public_slugs()
    print(f"Found {len(slugs)} public routes in canonical sitemap data")
    print("")
    
    base_mismatches = []
    missing_sites = []
    for slug in slugs:
        site_dir = site_dir_for_slug(slug)
        build_root = find_best_build_root(site_dir)
        packages = package_dirs(site_dir)
        status = "exists" if site_dir.exists() else "missing"
        base_status = ""
        if not site_dir.exists():
            missing_sites.append({
                "slug": slug,
                "folder": site_dir.name,
            })
        else:
            base_ok, current_base, expected_base = check_vite_base_matches_route(slug, site_dir)
            if not base_ok:
                base_status = f" ⚠️  base mismatch: {current_base} should be {expected_base}"
                base_mismatches.append({
                    "slug": slug,
                    "folder": site_dir.name,
                    "current": current_base,
                    "expected": expected_base
                })
        
        print(f"{slug:20} -> {site_dir.name} ({status}){base_status}")
        print(f"  packages: {', '.join(p.relative_to(site_dir).as_posix() for p in packages) if packages else 'none'}")
        print(f"  build: {build_root.relative_to(site_dir).as_posix() if build_root else 'missing'}")
        print(f"  dist: {'yes' if (site_dir / 'dist').exists() else 'no'}")
        print(f"  api-client shim: {'missing' if needs_api_client_shim(site_dir) else 'ok'}")
    
    if missing_sites or base_mismatches:
        print("\n" + "=" * 70)
        if missing_sites:
            print(f"⚠️  Missing site directories: {len(missing_sites)}")
            print("These slugs are still in the canonical sitemap, but their site folders/builds are missing:")
            for item in missing_sites:
                print(f"  - {item['slug']} -> {item['folder']}")
            if base_mismatches:
                print("")
        if base_mismatches:
            print(f"⚠️  Vite base path mismatches: {len(base_mismatches)}")
            print("These can cause blank pages because assets are requested from wrong URLs.")
            print("Fix by setting `base: './'` (recommended) or `base: '/<slug>/'` in that site's vite.config.*.")
        return 1
    
    return 0


def cmd_build(args: argparse.Namespace) -> int:
    all_slugs = load_public_slugs()
    selected_slugs = getattr(args, "slugs", None)
    if selected_slugs:
        unknown = [slug for slug in selected_slugs if slug not in all_slugs]
        if unknown:
            print(f"Unknown slug(s): {', '.join(unknown)}")
            return 2
        slugs = selected_slugs
    else:
        slugs = all_slugs

    ready = 0
    failed: list[str] = []

    for index, slug in enumerate(slugs, start=1):
        site_dir = site_dir_for_slug(slug)
        if not (site_dir / "package.json").exists() and not package_dirs(site_dir):
            print(f"[{index}/{len(slugs)}] {slug}: skipped (no package.json)")
            continue

        print(f"[{index}/{len(slugs)}] {slug}: building {site_dir.name}")
        if needs_api_client_shim(site_dir):
            print("  ⚠️  missing src/api-client.js shim; build may fail until the import graph is fixed")
        try:
            build_root = run_site_build(site_dir)
            normalized = normalize_build_output(site_dir) or build_root
            print(f"  ✅ {normalized.relative_to(site_dir).as_posix()}")
            ready += 1
        except subprocess.CalledProcessError as exc:
            print(f"  ❌ build failed: {exc}")
            failed.append(slug)
        except Exception as exc:
            print(f"  ❌ {exc}")
            failed.append(slug)

    print("")
    print(f"Build complete: {ready} succeeded, {len(failed)} failed")
    if failed:
        print("Failed sites:")
        for slug in failed:
            print(f"  - {slug}")
        return 1

    if selected_slugs:
        print("Filtered build complete; run './nai routes' if route output should be regenerated.")
    else:
        subprocess.run([tool_python(), "-m", "nai_suite.update_vercel"], check=True, cwd=ROOT)
    return 0


def prepare_vercel_output() -> Path:
    write_all_mvps_page()

    vercel_config_path = ROOT / "vercel.json"
    output_root = ROOT / ".vercel" / "output"
    static_root = output_root / "static"

    if output_root.exists():
        shutil.rmtree(output_root)
    static_root.mkdir(parents=True, exist_ok=True)

    vercel_config = json.loads(vercel_config_path.read_text())
    routes = [route for route in vercel_config.get("routes", []) if isinstance(route, dict)]

    copied: set[Path] = set()
    for route in routes:
        dest = str(route.get("dest", "")).strip()
        if not dest.startswith("/websites/"):
            continue
        source_rel = Path(dest.lstrip("/").split("/$1", 1)[0])
        source_root = ROOT / source_rel
        if not source_root.exists() or source_root.resolve() in copied:
            continue
        target_root = static_root / source_rel
        shutil.copytree(source_root, target_root, symlinks=True)
        copied.add(source_root.resolve())

    landing_page = ROOT / "landing-page"
    if landing_page.exists():
        shutil.copytree(landing_page, static_root / "landing-page", symlinks=True)

    output_root.mkdir(parents=True, exist_ok=True)
    (output_root / "config.json").write_text(
        json.dumps({"version": 3, "routes": routes}, indent=2) + "\n"
    )
    return output_root


