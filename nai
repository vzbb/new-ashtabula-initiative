def cmd_tooling(_: argparse.Namespace) -> int:
    subprocess.run([tool_python(), "-m", "nai_suite.tooling_registry"], check=True, cwd=ROOT)
    return 0


def cmd_outreach_readiness(_: argparse.Namespace) -> int:
    subprocess.run([tool_python(), "-m", "nai_suite.generate_outreach_readiness"], check=True, cwd=ROOT)
    return 0


def cmd_saybrook_request_api(args: argparse.Namespace) -> int:
    cmd = [
        tool_python(),
        "-m",
        "nai_suite.saybrook_request_api",
        "--host",
        args.host,
        "--port",
        str(args.port),
        "--db-path",
        str(args.db_path),
    ]
    subprocess.run(cmd, check=True, cwd=ROOT)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="nai", description="NAI workflow helper")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("scan", help="inspect site build status").set_defaults(func=cmd_scan)
    build = sub.add_parser("build", help="install dependencies and build sites")
    build.add_argument("--slugs", nargs="+", help="build only the listed canonical slug(s)")
    build.set_defaults(func=cmd_build)
    sub.add_parser("routes", help="regenerate vercel.json").set_defaults(func=cmd_routes)
    sub.add_parser("sitemap-sync", help="validate SITEMAP.json and render SITEMAP.md").set_defaults(func=cmd_sitemap_sync)
    sub.add_parser("sitemap-render-md", help="render SITEMAP.md from canonical SITEMAP.json").set_defaults(func=cmd_sitemap_render_md)
    sub.add_parser("sitemap-import-md", help="bootstrap SITEMAP.json from SITEMAP.md").set_defaults(func=cmd_sitemap_import_md)
    sub.add_parser("sitemap-validate", help="validate SITEMAP.json").set_defaults(func=cmd_sitemap_validate)
    sub.add_parser("render-all-mvps", help="generate landing-page/all-mvps.html from canonical sitemap data").set_defaults(func=cmd_render_all_mvps)
    sub.add_parser("fix-bases", help="fix vite.config.js base paths to match routes").set_defaults(func=cmd_fix_bases)
    deploy = sub.add_parser("deploy", help="build everything and deploy with Vercel")
    deploy.add_argument("--confirm-production", action="store_true", help="explicitly allow the production Vercel deploy path")
    deploy.set_defaults(func=cmd_deploy)
    screenshots = sub.add_parser("screenshots", help="capture sitemap screenshots from local build outputs")
    screenshots.add_argument("--live", action="store_true", help="navigate the live production URLs instead of local previews")
    screenshots.add_argument("--headed", action="store_true", help="show the browser window while capturing")
    screenshots.add_argument("--slugs", nargs="*", default=None, help="optional list of site slugs to capture")
    screenshots.add_argument("--browse-only", action="store_true", help="visit pages without taking screenshots or building the gallery")
    screenshots.add_argument("--linger", type=float, default=None, help="seconds to pause on each site before screenshotting")
    screenshots.add_argument("--settle-ms", type=int, default=None, help="milliseconds to pause after a page settles before capture")
    screenshots.add_argument("--slow-mo", type=int, default=0, help="delay between browser actions in milliseconds")
    screenshots.set_defaults(func=cmd_screenshots)

    browse = sub.add_parser("browse", help="open the live production URLs in a visible browser")
    browse.add_argument("--linger", type=float, default=None, help="seconds to pause on each site before moving on")
    browse.add_argument("--settle-ms", type=int, default=None, help="milliseconds to pause after a page settles before moving on")
    browse.add_argument("--slow-mo", type=int, default=0, help="delay between browser actions in milliseconds")
    browse.set_defaults(func=cmd_browse)

    analyze = sub.add_parser("analyze-screenshots", help="run vision analysis over sitemap screenshots and write a JSON report")
    analyze.add_argument("--image-dir", type=Path, default=None, help="directory containing screenshot images")
    analyze.add_argument("--output", type=Path, default=None, help="path to write the JSON report")
    analyze.add_argument("--model", default=None, help="OpenRouter model id to use")
    analyze.add_argument("--quality", choices=["fast", "deep"], default="fast", help="model preset to use when --model is not set")
    analyze.add_argument("--slugs", nargs="*", default=None, help="optional list of site slugs to analyze")
    analyze.add_argument("--slugs-file", type=Path, default=None, help="newline-delimited list of site slugs to analyze")
    analyze.add_argument("--limit", type=int, default=None, help="optional limit for testing")
    analyze.add_argument("--temperature", type=float, default=None, help="sampling temperature")
    analyze.add_argument("--max-tokens", type=int, default=None, help="maximum completion tokens per image")
    analyze.add_argument("--sleep", type=float, default=None, help="seconds to sleep between requests")
    analyze.add_argument("--focus", action=argparse.BooleanOptionalAction, default=False, help="use few-shot calibration examples for a focused subject pass")
    analyze.add_argument("--branding-only", action=argparse.BooleanOptionalAction, default=False, help="only revise branding/target fields and merge them into the existing report")
    analyze.add_argument("--verify-targets", action=argparse.BooleanOptionalAction, default=True, help="use web search to verify candidate target entities")
    analyze.set_defaults(func=cmd_analyze_screenshots)

    progress = sub.add_parser("progress", help="build the score-focused progress dashboard from archived JSON reports")
    progress.add_argument("--archive-dir", type=Path, default=None, help="directory holding timestamped report snapshots")
    progress.add_argument("--current-report", type=Path, default=None, help="path to the current visual_analysis_report.json")
    progress.add_argument("--output", type=Path, default=None, help="path to write the HTML dashboard")
    progress.add_argument("--data-output", type=Path, default=None, help="path to write the compact JSON payload")
    progress.add_argument("--open", action="store_true", help="open the generated dashboard in the default browser")
    progress.set_defaults(func=cmd_progress)

    sub.add_parser("hub", help="open the lightweight browser wrapper for the NAI tool suite").set_defaults(func=cmd_hub)
    sub.add_parser("tooling", help="show the core/support/legacy script registry and refresh its markdown view").set_defaults(func=cmd_tooling)
    sub.add_parser("outreach-readiness", help="generate an outreach-oriented readiness board from live MVP, visual QA, and artifact data").set_defaults(func=cmd_outreach_readiness)

    request_api = sub.add_parser("saybrook-request-api", help="serve the Saybrook request intake SQLite writer API")
    request_api.add_argument("--host", default="0.0.0.0", help="host to bind the request API server to")
    request_api.add_argument("--port", type=int, default=18765, help="port to bind the request API server to")
    request_api.add_argument("--db-path", type=Path, default=ROOT / "data" / "saybrook-zoning-requests.db", help="SQLite database path for request intake rows")
    request_api.set_defaults(func=cmd_saybrook_request_api)

    clone = sub.add_parser("clone-mvp", help="plan a controlled child MVP clone from a strong parent")
    clone.add_argument("--parent-slug", required=True, help="canonical slug of the parent MVP")
    clone.add_argument("--new-slug", required=True, help="canonical slug for the child MVP")
    clone.add_argument("--site-name", required=True, help="human-readable site name for the child MVP")
    clone.add_argument("--target", required=True, help="primary target buyer for the child MVP")
    clone.add_argument("--description", required=True, help="short route description for the child MVP")
    clone.add_argument("--category", default=None, help="category label; defaults to the parent route category")
    clone.add_argument("--new-folder", default=None, help="folder name under websites/; defaults to the new slug")
    clone.add_argument("--secondary-targets", default=None, help="optional semicolon-delimited clone candidates for the target ledger")
    clone.add_argument("--notes", default=None, help="optional target-ledger notes for the new child")
    clone.add_argument("--index", type=int, default=None, help="optional explicit route index; defaults to the next canonical index")
    clone.add_argument("--force", action="store_true", help="allow planning even if the parent currently lacks a detected build root")
    clone.add_argument("--dry-run", action="store_true", default=False, help="show the full clone plan without writing files")
    clone.set_defaults(func=cmd_clone_mvp)

    focus = sub.add_parser("focus-analyze", help="run a narrow, few-shot-calibrated analysis pass on selected slugs")
    focus.add_argument("--image-dir", type=Path, default=None, help="directory containing screenshot images")
    focus.add_argument("--output", type=Path, default=None, help="path to write the JSON report")
    focus.add_argument("--model", default=None, help="OpenRouter model id to use")
    focus.add_argument("--quality", choices=["fast", "deep"], default="deep", help="model preset to use when --model is not set")
    focus.add_argument("--slugs", nargs="*", default=None, help="optional list of site slugs to analyze")
    focus.add_argument("--slugs-file", type=Path, default=None, help="newline-delimited list of site slugs to analyze")
    focus.add_argument("--limit", type=int, default=None, help="optional limit for testing")
    focus.add_argument("--temperature", type=float, default=None, help="sampling temperature")
    focus.add_argument("--max-tokens", type=int, default=None, help="maximum completion tokens per image")
    focus.add_argument("--sleep", type=float, default=None, help="seconds to sleep between requests")
    focus.add_argument("--verify-targets", action=argparse.BooleanOptionalAction, default=True, help="use web search to verify candidate target entities")
    focus.set_defaults(func=cmd_analyze_screenshots, focus=True)

    branding = sub.add_parser("branding-pass", help="re-analyze only the branding layer and merge it into the existing report")
    branding.add_argument("--image-dir", type=Path, default=None, help="directory containing screenshot images")
    branding.add_argument("--output", type=Path, default=None, help="path to write the JSON report")
    branding.add_argument("--model", default=None, help="OpenRouter model id to use")
    branding.add_argument("--quality", choices=["fast", "deep"], default="deep", help="model preset to use when --model is not set")
    branding.add_argument("--slugs", nargs="*", default=None, help="optional list of site slugs to analyze")
    branding.add_argument("--slugs-file", type=Path, default=None, help="newline-delimited list of site slugs to analyze")
    branding.add_argument("--limit", type=int, default=None, help="optional limit for testing")
    branding.add_argument("--temperature", type=float, default=None, help="sampling temperature")
    branding.add_argument("--max-tokens", type=int, default=None, help="maximum completion tokens per image")
    branding.add_argument("--sleep", type=float, default=None, help="seconds to sleep between requests")
    branding.add_argument("--verify-targets", action=argparse.BooleanOptionalAction, default=True, help="use web search to verify candidate target entities")
    branding.set_defaults(func=cmd_analyze_screenshots, branding_only=True)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
