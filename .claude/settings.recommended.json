{
  "_comment": "Recommended NAI permission ruleset. NOT active. Review it, then either merge it into .claude/settings.json yourself or ask Claude to run /update-config. Claude is intentionally blocked from writing its own settings file. Rationale is in .claude/ORCHESTRATION_LAYER.md.",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./nai pipeline validate)",
      "Bash(./nai pipeline status)",
      "Bash(./nai pipeline render)",
      "Bash(./nai pipeline context:*)",
      "Bash(./nai pipeline assign:*)",
      "Bash(./nai scan:*)",
      "Bash(./nai tooling:*)",
      "Bash(./nai build --slugs:*)",
      "Bash(./nai screenshots --slugs:*)",
      "Bash(./nai analyze-screenshots:*)",
      "Bash(./nai sitemap-validate)",
      "Bash(./nai outreach-readiness:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python3 -m json.tool:*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "ask": [
      "Bash(./nai pipeline pass:*)",
      "Bash(./nai pipeline fail:*)",
      "Bash(./nai pipeline reset:*)",
      "Bash(./nai pipeline quarantine:*)",
      "Bash(./nai routes:*)",
      "Bash(./nai sitemap-render-md:*)",
      "Bash(./nai sitemap-import-md:*)",
      "Bash(./nai clone-mvp:*)",
      "Bash(./nai screenshots --live:*)",
      "Bash(./nai browse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)"
    ],
    "deny": [
      "Bash(./nai deploy:*)",
      "Bash(./nai fix-bases:*)",
      "Bash(./nai render-all-mvps:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git add -A:*)",
      "Bash(git commit -a:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.vercel)",
      "Read(./VITE_OPENROUTER_API_KEY)",
      "Edit(./NAI_STATE.json)",
      "Edit(./CHIEF_OF_STAFF.md)",
      "Edit(./SITEMAP.md)",
      "Edit(./NAI_TOOLCHAIN.md)",
      "Edit(./vercel.json)",
      "Edit(./.vercel/**)",
      "Write(./NAI_STATE.json)",
      "Write(./CHIEF_OF_STAFF.md)",
      "Write(./SITEMAP.md)",
      "Write(./NAI_TOOLCHAIN.md)",
      "Write(./vercel.json)",
      "Write(./.vercel/**)"
    ]
  }
}
